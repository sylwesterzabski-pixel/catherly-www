# Nazwy zmiennych bez wartości (granica bezwzględna: sekrety nigdy w repo).
# Wartości trzymaj wyłącznie w lokalnym .env (jest w .gitignore) lub w
# ustawieniach Vercel/GitHub Actions.

# Stripe — WYŁĄCZNIE klucz testowy (sk_test_...), wyłącznie odczyt.
# Klucz produkcyjny (sk_live_...) jest w tym repozytorium nielegalny;
# skrypt bramki cennika przerywa pracę, jeśli go wykryje.
STRIPE_TEST_SECRET_KEY=

# Resend — e-maile transakcyjne (ADR-016); potrzebny dopiero w późniejszej fazie.
RESEND_API_KEY=
